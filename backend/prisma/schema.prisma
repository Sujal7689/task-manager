// Phase 1 schema: Company/Department/Category master data, Users, Project,
// Milestone, Task (self-referencing for Sub-tasks), Task<->User assignees.
// Activity Log, Timesheet, Notification, Audit Log, Zoho Sync Log tables
// are introduced in their respective later phases (2/3/5/6) per Section 13.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- 5.1 Master Data ----------

model Company {
  id          String       @id @default(cuid())
  name        String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  departments Department[]
  users       User[]
  projects    Project[]
  tasks       Task[]
  escalationRules EscalationRule[]
  kpiWeightConfig KpiWeightConfig?

  @@map("companies")
}

model Department {
  id        String    @id @default(cuid())
  name      String
  companyId String    @map("company_id")
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  users     User[]
  projects  Project[]
  tasks     Task[]
  dailyActivities DailyActivity[]
  escalationRules EscalationRule[]

  @@unique([companyId, name])
  @@map("departments")
}

model Category {
  id             String     @id @default(cuid())
  name           String
  parentId       String?    @map("parent_id")
  parent         Category?  @relation("CategoryToSubCategory", fields: [parentId], references: [id], onDelete: Cascade)
  subCategories  Category[] @relation("CategoryToSubCategory")
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  tasks          Task[]     @relation("TaskCategory")
  tasksSubCat    Task[]     @relation("TaskSubCategory")

  @@map("categories")
}

// ---------- 5.2 Users ----------

enum Role {
  ADMIN
  MANAGER
  TEAM_LEAD
  STAFF
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

model User {
  id                    String     @id @default(cuid())
  name                  String
  email                 String     @unique
  phone                 String?
  passwordHash          String     @map("password_hash")
  role                  Role
  departmentId          String?    @map("department_id")
  department            Department? @relation(fields: [departmentId], references: [id])
  companyId             String?    @map("company_id")
  company               Company?   @relation(fields: [companyId], references: [id])
  reportingManagerId    String?    @map("reporting_manager_id")
  reportingManager      User?      @relation("ReportingManager", fields: [reportingManagerId], references: [id])
  directReports         User[]     @relation("ReportingManager")
  status                UserStatus @default(ACTIVE)
  dateJoined             DateTime   @default(now()) @map("date_joined")
  isZohoFallbackAssignee Boolean    @default(false) @map("is_zoho_fallback_assignee")
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  projectsOwned         Project[]  @relation("ProjectOwner")
  milestonesOwned       Milestone[] @relation("MilestoneOwner")
  tasksAssignedBy       Task[]     @relation("TaskAssignedBy")
  taskAssignments       TaskAssignee[]
  activityLogs          ActivityLog[]  @relation("ActivityLoggedBy")
  dailyActivities       DailyActivity[] @relation("DailyActivityLoggedBy")
  timesheetEntries      TimesheetEntry[]
  notifications         NotificationLog[]
  auditLogs             AuditLog[]     @relation("AuditChangedBy")
  passwordResetTokens   PasswordResetToken[]
  attendanceRecords     Attendance[]
  leaves                Leave[]

  @@map("users")
}

// Self-service "Forgot password" (login page). A random token is emailed to
// the user; only its SHA-256 hash is stored here, so a DB leak alone can't
// be used to reset accounts. Expires quickly (1h) and is single-use.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

// ---------- 5.3 Project ----------

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
}

model Project {
  id           String        @id @default(cuid())
  name         String
  companyId    String        @map("company_id")
  company      Company       @relation(fields: [companyId], references: [id])
  departmentId String        @map("department_id")
  department   Department    @relation(fields: [departmentId], references: [id])
  startDate    DateTime?     @map("start_date")
  endDate      DateTime?     @map("end_date")
  ownerId      String        @map("owner_id")
  owner        User          @relation("ProjectOwner", fields: [ownerId], references: [id])
  status       ProjectStatus @default(PLANNING)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  milestones   Milestone[]
  tasks        Task[]
  dailyActivities DailyActivity[]

  @@map("projects")
}

// ---------- 5.4 Milestone ----------

enum MilestoneStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  DELAYED
}

model Milestone {
  id         String          @id @default(cuid())
  name       String
  projectId  String          @map("project_id")
  project    Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  targetDate DateTime?       @map("target_date")
  ownerId    String          @map("owner_id")
  owner      User            @relation("MilestoneOwner", fields: [ownerId], references: [id])
  status     MilestoneStatus @default(NOT_STARTED)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  tasks      Task[]
  notifications NotificationLog[]

  @@map("milestones")
}

// ---------- 5.5 Task (Sub-task = Task with parentTaskId set) ----------

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RecurringFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  ON_HOLD
  UNDER_REVIEW
  COMPLETED
  CANCELLED
}

enum TaskSource {
  INTERNAL
  ZOHO_CRM
}

model Task {
  // Identification
  id             String      @id @default(cuid())
  taskNumber     String      @unique @map("task_number") // e.g. TSK-2026-00001
  name           String      @map("task_name")
  description    String?     @map("task_description")

  // Hierarchy
  projectId      String?     @map("project_id")
  project        Project?    @relation(fields: [projectId], references: [id])
  milestoneId    String?     @map("milestone_id")
  milestone      Milestone?  @relation(fields: [milestoneId], references: [id])
  parentTaskId   String?     @map("parent_task_id")
  parentTask     Task?       @relation("TaskSubtasks", fields: [parentTaskId], references: [id])
  subTasks       Task[]      @relation("TaskSubtasks")

  // Classification
  categoryId     String?     @map("category_id")
  category       Category?   @relation("TaskCategory", fields: [categoryId], references: [id])
  subCategoryId  String?     @map("sub_category_id")
  subCategory    Category?   @relation("TaskSubCategory", fields: [subCategoryId], references: [id])
  priority       Priority    @default(MEDIUM)
  tags           String[]    @default([])

  // Scheduling
  startDate      DateTime?   @map("start_date")
  dueDate        DateTime?   @map("due_date")
  estimatedHours  Decimal?    @map("estimated_hours") @db.Decimal(6, 2)
  isRecurring    Boolean     @default(false) @map("is_recurring")
  recurringFrequency RecurringFrequency? @map("recurring_frequency")

  // Ownership & Assignment
  companyId      String?     @map("company_id")
  company        Company?    @relation(fields: [companyId], references: [id])
  departmentId   String?     @map("department_id")
  department     Department? @relation(fields: [departmentId], references: [id])
  assignedById   String      @map("assigned_by_id")
  assignedBy     User        @relation("TaskAssignedBy", fields: [assignedById], references: [id])
  assignees      TaskAssignee[]
  partyName      String?     @map("party_name")
  refId          String?     @map("ref_id")

  // Progress & Status
  status         TaskStatus  @default(NOT_STARTED)
  percentComplete Int        @default(0) @map("percent_complete")

  // Source (Zoho Integration) — columns exist from Phase 1 per Section 5.5,
  // populated/used starting Phase 5.
  source         TaskSource  @default(INTERNAL)
  zohoTaskId     String?     @unique @map("zoho_task_id")
  lastSyncedAt   DateTime?   @map("last_synced_at")

  // Reference
  attachments    TaskAttachment[]

  // Quality/Feedback (Section 6.5) — manager 1-5 rating set on task closure
  closureRating  Int?        @map("closure_rating")
  // Set once, the first time status transitions to COMPLETED — used for On-Time
  // Completion % and Estimate Accuracy (Section 6.5) instead of `updatedAt`,
  // which would drift if the task is edited again after closure.
  closedAt       DateTime?   @map("closed_at")

  // System
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  activityLogs    ActivityLog[]
  timesheetEntries TimesheetEntry[]
  notifications    NotificationLog[]
  comments         Comment[]

  @@index([projectId])
  @@index([milestoneId])
  @@index([parentTaskId])
  @@index([status])
  @@index([dueDate])
  @@map("tasks")
}

// Many-to-many Task <-> User for "Assigned To" (multiple assignees allowed)
model TaskAssignee {
  taskId     String   @map("task_id")
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now()) @map("assigned_at")

  @@id([taskId, userId])
  @@map("task_assignees")
}

// Basic attachment metadata for local-disk file storage (Section 9 permits
// local filesystem storage). Actual object storage (MinIO) can replace the
// storage backend later without changing this table's shape.
model TaskAttachment {
  id         String   @id @default(cuid())
  taskId     String   @map("task_id")
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fileName   String   @map("file_name")
  filePath   String   @map("file_path")
  fileSize   Int      @map("file_size")
  mimeType   String   @map("mime_type")
  uploadedAt DateTime @default(now()) @map("uploaded_at")

  @@map("task_attachments")
}

// ==================== Phase 2: Activity Log + Timesheet ====================

enum ActivityType {
  UPDATE
  CALL
  MEETING
  FOLLOW_UP
  DOCUMENT
  OTHER
}

enum ActivityLogStatus {
  IN_PROGRESS
  BLOCKED
  COMPLETED
}

model ActivityLog {
  id               String            @id @default(cuid())
  taskId           String            @map("task_id")
  task             Task              @relation(fields: [taskId], references: [id], onDelete: Cascade)

  name             String?
  activityType     ActivityType      @map("activity_type")
  status           ActivityLogStatus @default(IN_PROGRESS)

  activityDate     DateTime          @map("activity_date")
  timeIn           DateTime?         @map("time_in")
  timeOut          DateTime?         @map("time_out")
  // Auto-calculated from timeIn/timeOut at write time; manual override requires overrideReason.
  workingHours     Decimal           @map("working_hours") @db.Decimal(5, 2)
  isManualOverride Boolean           @default(false) @map("is_manual_override")
  overrideReason   String?           @map("override_reason")

  feedback         String?
  attachments      ActivityAttachment[]

  loggedById       String            @map("logged_by_id")
  loggedBy         User              @relation("ActivityLoggedBy", fields: [loggedById], references: [id])

  createdAt        DateTime          @default(now())

  @@index([taskId])
  @@index([loggedById])
  @@index([activityDate])
  @@map("activity_logs")
}

model ActivityAttachment {
  id            String      @id @default(cuid())
  activityLogId String      @map("activity_log_id")
  activityLog   ActivityLog @relation(fields: [activityLogId], references: [id], onDelete: Cascade)
  fileName      String      @map("file_name")
  filePath      String      @map("file_path")
  fileSize      Int         @map("file_size")
  mimeType      String      @map("mime_type")
  uploadedAt    DateTime    @default(now()) @map("uploaded_at")

  @@map("activity_attachments")
}

// Standalone daily-activity log — mirrors ActivityLog's form shape (type,
// time in/out or manual-hours override, attachments) but isn't tied to a
// Task; a user logs general work here (calls, meetings, admin work, etc.)
// throughout the day. Optionally tagged with a Project/Department. Logged
// hours are folded into the user's Timesheet total (see dailyActivities.service
// for the upsert-add into TimesheetEntry) so they show up in the same
// totals/reports as task work, without needing a 1:1 row per activity.
model DailyActivity {
  id               String            @id @default(cuid())
  name             String?
  activityType     ActivityType      @map("activity_type")
  status           ActivityLogStatus @default(IN_PROGRESS)

  activityDate     DateTime          @map("activity_date")
  timeIn           DateTime?         @map("time_in")
  timeOut          DateTime?         @map("time_out")
  workingHours     Decimal           @map("working_hours") @db.Decimal(5, 2)
  isManualOverride Boolean           @default(false) @map("is_manual_override")
  overrideReason   String?           @map("override_reason")

  description      String?

  projectId        String?           @map("project_id")
  project          Project?          @relation(fields: [projectId], references: [id])
  departmentId     String?           @map("department_id")
  department       Department?       @relation(fields: [departmentId], references: [id])

  attachments      DailyActivityAttachment[]

  loggedById       String            @map("logged_by_id")
  loggedBy         User              @relation("DailyActivityLoggedBy", fields: [loggedById], references: [id])

  createdAt        DateTime          @default(now())

  @@index([loggedById])
  @@index([activityDate])
  @@map("daily_activities")
}

model DailyActivityAttachment {
  id              String        @id @default(cuid())
  dailyActivityId String        @map("daily_activity_id")
  dailyActivity   DailyActivity @relation(fields: [dailyActivityId], references: [id], onDelete: Cascade)
  fileName        String        @map("file_name")
  filePath        String        @map("file_path")
  fileSize        Int           @map("file_size")
  mimeType        String        @map("mime_type")
  uploadedAt      DateTime      @default(now()) @map("uploaded_at")

  @@map("daily_activity_attachments")
}

enum TimesheetEntryType {
  TASK_WORK
  MEETING
  ADMIN
  LEAVE
  BREAK
  ACTIVITY
}

model TimesheetEntry {
  id          String             @id @default(cuid())
  userId      String             @map("user_id")
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        DateTime           @db.Date
  taskId      String?            @map("task_id")
  task        Task?              @relation(fields: [taskId], references: [id])
  hoursLogged Decimal            @map("hours_logged") @db.Decimal(5, 2)
  entryType   TimesheetEntryType @default(TASK_WORK) @map("entry_type")
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([userId, date, taskId, entryType])
  @@index([userId, date])
  @@map("timesheet_entries")
}

// ==================== Attendance & Leave ====================
// Independent of Timesheet — plain clock-in/out plus self-declared leave,
// no approval workflow and no balance/quota tracking.

model Attendance {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date       DateTime  @db.Date
  checkInAt  DateTime  @map("check_in_at")
  checkOutAt DateTime? @map("check_out_at")
  // Captured client-side via the browser Geolocation API at the moment of
  // check-in/out — best-effort, not required (a denied/unavailable location
  // never blocks the check-in/out itself, so these stay nullable).
  checkInLat  Float?   @map("check_in_lat")
  checkInLng  Float?   @map("check_in_lng")
  checkOutLat Float?   @map("check_out_lat")
  checkOutLng Float?   @map("check_out_lng")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([userId, date])
  @@map("attendance_records")
}

enum LeaveType {
  SICK
  CASUAL
}

model Leave {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  leaveType LeaveType @map("leave_type")
  startDate DateTime  @map("start_date") @db.Date
  endDate   DateTime  @map("end_date") @db.Date
  reason    String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
  @@map("leaves")
}

// ==================== Phase 3: Notifications + Escalation + Comments ====================

enum NotificationType {
  TASK_DUE_SOON
  TASK_OVERDUE_DAY1
  TASK_OVERDUE_DAY3
  TASK_OVERDUE_DAY7
  MILESTONE_AT_RISK
  TASK_STATUS_CHANGED
  TASK_ASSIGNED
  MENTIONED
  UNMATCHED_ZOHO_OWNER
  CRM_BACKFILL_FAILED
}

model NotificationLog {
  id         String           @id @default(cuid())
  taskId     String?          @map("task_id")
  task       Task?            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  milestoneId String?         @map("milestone_id")
  milestone  Milestone?       @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  recipientId String          @map("recipient_id")
  recipient  User             @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  type       NotificationType
  message    String
  sentOn     DateTime         @default(now()) @map("sent_on")
  readStatus Boolean          @default(false) @map("read_status")
  emailSent  Boolean          @default(false) @map("email_sent")

  @@index([recipientId, readStatus])
  @@map("notification_log")
}

// Escalation ladder configurable per Company/Department (Section 6.9). A null
// companyId/departmentId row is the global default; more specific rows override it.
model EscalationRule {
  id                   String      @id @default(cuid())
  companyId            String?     @map("company_id")
  company              Company?    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  departmentId         String?     @map("department_id")
  department           Department? @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  overdueDay           Int         @map("overdue_day")
  notifyDepartmentHead Boolean     @default(false) @map("notify_department_head")
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  @@map("escalation_rules")
}

// Minimal Comments/Mentions (Section 6.10) — needed as a trigger source for the
// "Mentioned in comment" notification (Section 6.9). Not a dedicated phase in
// Section 13; kept intentionally lightweight (no threading/edit history yet).
model Comment {
  id               String   @id @default(cuid())
  taskId           String   @map("task_id")
  task             Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId         String   @map("author_id")
  body             String
  mentionedUserIds String[] @map("mentioned_user_ids")
  createdAt        DateTime @default(now())

  @@index([taskId])
  @@map("comments")
}

// ==================== Phase 4: KPI Configuration ====================

// Weights per Section 6.5 formula; defaults match Section 12 decision #2
// (40/25/20/15). A null companyId row is the global default.
model KpiWeightConfig {
  id                     String   @id @default(cuid())
  companyId              String?  @unique @map("company_id")
  company                Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  onTimeWeight           Decimal  @default(40) @map("on_time_weight") @db.Decimal(5, 2)
  estimateAccuracyWeight Decimal  @default(25) @map("estimate_accuracy_weight") @db.Decimal(5, 2)
  volumeWeight           Decimal  @default(20) @map("volume_weight") @db.Decimal(5, 2)
  qualityWeight          Decimal  @default(15) @map("quality_weight") @db.Decimal(5, 2)
  updatedAt              DateTime @updatedAt

  @@map("kpi_weight_configs")
}

// Admin-editable runtime settings (Configuration tab) — a single global row,
// always looked up/written via id "singleton". Any field left null here falls
// back to the matching .env value (see backend/src/modules/config/config.service.ts),
// so a fresh deploy keeps working off .env until an Admin fills in the UI.
model AppConfig {
  id                        String   @id @default("singleton")

  smtpHost                  String?  @map("smtp_host")
  smtpPort                  Int?     @map("smtp_port")
  smtpUser                  String?  @map("smtp_user")
  smtpPassword              String?  @map("smtp_password")
  smtpFrom                  String?  @map("smtp_from")

  zohoClientId              String?  @map("zoho_client_id")
  zohoClientSecret          String?  @map("zoho_client_secret")
  zohoRefreshToken          String?  @map("zoho_refresh_token")
  zohoAccountsBaseUrl       String?  @map("zoho_accounts_base_url")
  zohoApiBaseUrl            String?  @map("zoho_api_base_url")

  notificationCronSchedule  String?  @map("notification_cron_schedule")
  weeklyReportCronSchedule  String?  @map("weekly_report_cron_schedule")
  crmLeadsSyncCronSchedule  String?  @map("crm_leads_sync_cron_schedule")
  crmLeadsBackfillCronSchedule String? @map("crm_leads_backfill_cron_schedule")

  updatedAt                 DateTime @updatedAt

  @@map("app_config")
}

// ==================== Phase 5: Zoho CRM Sync ====================

enum ZohoSyncStatus {
  SUCCESS
  FAILED
}

model ZohoSyncLog {
  id          String         @id @default(cuid())
  zohoTaskId  String         @map("zoho_task_id")
  localTaskId String?        @map("local_task_id")
  direction   String         @default("ZOHO_TO_SYSTEM") @map("direction")
  status      ZohoSyncStatus
  errorMessage String?       @map("error_message")
  syncedAt    DateTime       @default(now()) @map("synced_at")

  @@index([status])
  @@map("zoho_sync_log")
}

// ==================== Phase 6: Audit Log ====================

model AuditLog {
  id           String   @id @default(cuid())
  entityType   String   @map("entity_type")
  entityId     String   @map("entity_id")
  fieldChanged String   @map("field_changed")
  oldValue     String?  @map("old_value")
  newValue     String?  @map("new_value")
  changedById  String   @map("changed_by_id")
  changedBy    User     @relation("AuditChangedBy", fields: [changedById], references: [id])
  changedAt    DateTime @default(now()) @map("changed_at")

  @@index([entityType, entityId])
  @@map("audit_log")
}

// Server-side error capture, viewable from Admin > Error Log — so a bare
// "Internal server error" response has a real stack trace behind it without
// needing shell/log access to wherever the app is deployed. Deliberately has
// no relation to User (unlike AuditLog above): it must still record an error
// caused by, say, a broken foreign key, so userId is a plain unlinked string.
model ErrorLog {
  id         String   @id @default(cuid())
  method     String
  path       String
  statusCode Int      @map("status_code")
  message    String
  stack      String?
  userId     String?  @map("user_id")
  userRole   String?  @map("user_role")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("error_log")
}

// ==================== Zoho CRM Leads Sync ====================
// Extends the Phase 5 Zoho integration (Tasks module, above) to also sync
// the Leads module, per the Leads + Reports spec. Leads has ~90 fields —
// only a core set is modeled as real columns; `rawData` keeps the full
// payload so a future report never needs a schema migration to reach a
// field that wasn't anticipated here.

enum CrmActivityType {
  NOTE
  CALL
  EVENT
  TASK
  EMAIL
}

model CrmLead {
  id             String    @id @default(cuid())
  zohoId         String    @unique @map("zoho_id")

  fullName       String?   @map("full_name")
  firstName      String?   @map("first_name")
  lastName       String?   @map("last_name")
  company        String?
  email          String?
  phone          String?
  leadSource     String?   @map("lead_source")
  description    String?
  tags           String[]  @default([])

  // Raw Lead_Status picklist value plus the derived funnel bucket it maps to
  // (see modules/crmLeads/funnelStage.ts) — kept alongside each other so a
  // report can group by either without recomputing.
  leadStatus     String?   @map("lead_status")
  funnelStage    String?   @map("funnel_stage")

  // Denormalized from the `Owner` field for fast querying without joining
  // back out to Zoho on every report. Kept as an informational field (shown
  // as "Owner" on the lead detail page) — no longer the basis for any
  // staff-level filtering/grouping, since Owner in this org doesn't reliably
  // track which real staff member is working a lead (see `staffName` below).
  ownerId        String?   @map("owner_id")
  ownerName      String?   @map("owner_name")
  ownerEmail     String?   @map("owner_email")

  // Client-added custom picklist field ("Staff Name", API name `Staff_Name`)
  // — the actual field of record for "who's working this lead", distinct
  // from Owner. This is the basis for every staff-level filter/grouping
  // across CRM Reports (Assignment Overview, Conversion Rate, Stage-wise,
  // Kanban, Lead-wise, Staff-wise, Closure Report's deals-converted, the
  // shared Staff filter). Zoho tracks no change history for it, so unlike
  // ownerName there's no equivalent of `ownerHistory` for this field.
  staffName      String?   @map("staff_name")

  converted            Boolean   @default(false)
  convertedAt           DateTime? @map("converted_at")
  convertedAccountId    String?   @map("converted_account_id")
  convertedContactId    String?   @map("converted_contact_id")
  convertedDealId       String?   @map("converted_deal_id")

  zohoCreatedTime  DateTime? @map("zoho_created_time")
  zohoModifiedTime DateTime? @map("zoho_modified_time")

  // Computed by our own sync as max(activity.occurredAt) across the unified
  // feed below — deliberately not trusted from Zoho's own Last_Activity_Time
  // rollup, which isn't granular enough for the "latest modification" report.
  lastActivityAt   DateTime? @map("last_activity_at")

  rawData        Json      @map("raw_data")
  syncedAt       DateTime  @default(now()) @map("synced_at")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  activities     CrmLeadActivity[]
  stageHistory   CrmLeadStageHistory[]
  ownerHistory   CrmLeadOwnerHistory[]

  @@index([funnelStage])
  @@index([ownerId])
  @@index([staffName])
  @@index([zohoModifiedTime])
  @@map("crm_leads")
}

// Unified Notes/Calls/Events/Tasks/Emails feed for a lead — the single table
// behind "latest modification to a lead", the lead-wise activity timeline,
// and the staff-wise "activities they logged" view.
model CrmLeadActivity {
  id             String           @id @default(cuid())
  leadId         String           @map("lead_id")
  lead           CrmLead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  activityType   CrmActivityType  @map("activity_type")
  zohoActivityId String           @map("zoho_activity_id")
  occurredAt     DateTime         @map("occurred_at")
  actorId        String?          @map("actor_id")
  actorName      String?          @map("actor_name")
  summary        String?
  // Only meaningfully populated for TASK (Due_Date) and CALL/TASK (a status
  // string — for Calls, derived from which related list it came from since
  // Zoho doesn't expose a clean status field there; see crmLeads.service.ts)
  // — added specifically for the Daily Report (Section: everyday morning-
  // meeting sheet). Nullable/unused for Note/Event/Email.
  dueDate        DateTime?        @map("due_date")
  status         String?
  rawData        Json             @map("raw_data")
  createdAt      DateTime         @default(now())

  // A re-sync re-fetches the same related-list pages; this stops that from
  // creating duplicate rows for an activity already seen.
  @@unique([leadId, activityType, zohoActivityId])
  @@index([leadId, occurredAt])
  @@index([actorId])
  @@index([activityType, dueDate])
  @@map("crm_lead_activity")
}

// Zoho's standard field-history tracking may not be enabled on Lead_Status
// (an org setting we can't change from here — see README "Known gaps"), so
// this table is how "stage moved X -> Y" is captured at all: every sync
// diffs the incoming Lead_Status against what's currently stored and, on a
// change, inserts a row here. It only starts capturing from the moment this
// feature first runs — there is no way to backfill it before that.
model CrmLeadStageHistory {
  id        String   @id @default(cuid())
  leadId    String   @map("lead_id")
  lead      CrmLead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  fromStage String?  @map("from_stage")
  toStage   String   @map("to_stage")
  changedAt DateTime @default(now()) @map("changed_at")

  @@index([leadId])
  @@index([changedAt])
  @@map("crm_lead_stage_history")
}

// Same diff-on-sync pattern as CrmLeadStageHistory, but for `Owner` — Zoho
// has no "date assigned" field of its own, so this is what answers "who a
// lead is assigned to and when that last changed".
model CrmLeadOwnerHistory {
  id            String   @id @default(cuid())
  leadId        String   @map("lead_id")
  lead          CrmLead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  fromOwnerId   String?  @map("from_owner_id")
  fromOwnerName String?  @map("from_owner_name")
  toOwnerId     String?  @map("to_owner_id")
  toOwnerName   String?  @map("to_owner_name")
  changedAt     DateTime @default(now()) @map("changed_at")

  @@index([leadId])
  @@index([changedAt])
  @@map("crm_lead_owner_history")
}

// Incremental-sync cursor, keyed by Zoho module name. The existing Tasks
// sync (above) re-fetches the whole module every run, which is fine at its
// volume; Leads plus five related lists per lead is not, so this is new.
model CrmSyncState {
  module                 String    @id
  lastSyncedModifiedTime DateTime? @map("last_synced_modified_time")
  lastFullSyncAt         DateTime? @map("last_full_sync_at")
  status                 String?

  @@map("crm_sync_state")
}

model CrmLeadSyncLog {
  id           String         @id @default(cuid())
  zohoLeadId   String         @map("zoho_lead_id")
  localLeadId  String?        @map("local_lead_id")
  status       ZohoSyncStatus
  errorMessage String?        @map("error_message")
  syncedAt     DateTime       @default(now()) @map("synced_at")

  @@index([status])
  @@map("crm_lead_sync_log")
}

// Backs atomic task-number generation. `scope` is "top-level" for the shared
// T-XXXX counter, or a parent task's id for that parent's T-XXXX-N sub-task
// counter. Read-then-insert (checking the current max, then creating with
// the next number) has an inherent race: two requests can both read the same
// max before either commits, compute the same "next" number, and collide on
// the taskNumber unique constraint — exactly what happened when two users
// created a task at the same moment. An atomic `INSERT ... ON CONFLICT DO
// UPDATE ... RETURNING value` on this table (see generateTaskNumber /
// generateSubTaskNumber) closes that race at the database level instead of
// just retrying around it.
model TaskNumberCounter {
  scope String @id
  value Int    @default(0)

  @@map("task_number_counter")
}
