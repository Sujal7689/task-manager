# ---- PostgreSQL ----
POSTGRES_USER=taskmgmt
POSTGRES_PASSWORD=change-me
POSTGRES_DB=taskmgmt
POSTGRES_PORT=5432

# Used by the backend container to connect to the postgres container.
DATABASE_URL=postgresql://taskmgmt:change-me@postgres:5432/taskmgmt

# ---- Backend ----
PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h
CORS_ORIGIN=http://localhost:5173
UPLOAD_DIR=uploads

# ---- Email (Section 6.9 alerts, Section 6.8 scheduled reports) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Task Management <no-reply@example.com>"
# If SMTP_HOST is blank, emails are logged to the console instead of sent —
# safe default for local/dev use.

# ---- Notification/escalation cron ----
NOTIFICATION_CRON_SCHEDULE="0 * * * *"
WEEKLY_REPORT_CRON_SCHEDULE="0 8 * * 1"

# ---- Frontend ----
# Local dev / docker-compose.yml alone: point at the backend directly.
# Production (docker-compose.prod.yml, behind the host's own nginx): use the
# relative path "/api" instead — the frontend is baked with this at BUILD
# time (in CI), so it must be set correctly before the image is built, not
# just before `up`.
VITE_API_URL=http://localhost:4000/api

# ---- Production only (docker-compose.prod.yml) ----
# Not read by compose itself — it's just for your reference and for the
# host nginx server-block / CI smoke test to target. TLS termination and
# domain routing happen in nginx on the host, outside this project.
DOMAIN=

# Local port the in-stack nginx proxy listens on (127.0.0.1 only). Point the
# host's nginx `proxy_pass` at http://127.0.0.1:<this port>. Change it if
# 8080 is already used by something else on the server.
PROXY_PORT=8080

# ---- Zoho CRM Sync (Phase 5 — placeholders only, unused until then) ----
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNTS_BASE_URL=https://accounts.zoho.com
ZOHO_API_BASE_URL=https://www.zohoapis.com
ZOHO_POLL_INTERVAL_MINUTES=15
ZOHO_FALLBACK_ASSIGNEE_EMAIL=admin@example.com

# ---- Zoho CRM Leads sync (Leads + Reports spec) ----
# Incremental poll (Section 4.2). Same OAuth credentials as above — no
# separate connection to configure. Leave as-is unless Zoho API credit
# limits require a slower cadence.
CRM_LEADS_SYNC_CRON_SCHEDULE="*/15 * * * *"